APP_ENV=dev
DATA_DIR=./data

# mock keeps local smoke runs independent from external services.
# Options:
# - mock: local deterministic responses, no external API calls.
# - openai_compatible: one global OpenAI-compatible provider.
# - router: route each prompt model id through configs/llm.yaml.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=60
LLM_CONFIG_PATH=configs/llm.yaml

# Router provider credentials. Fill only the providers you actually use.
LLM_DOUBAO_BASE_URL=
LLM_DOUBAO_API_KEY=
LLM_DEEPSEEK_BASE_URL=
LLM_DEEPSEEK_API_KEY=
LLM_KIMI_BASE_URL=
LLM_KIMI_API_KEY=
LLM_GLM_BASE_URL=
LLM_GLM_API_KEY=

SEARCH_PROVIDER=none
FETCH_PROVIDER=none
# auto: use MinerU first when MINERU_API_TOKEN is configured, then fallback to PyMuPDF.
# pymupdf/local: skip MinerU and use local PyMuPDF for PDF parsing.
PARSER_BACKEND=auto

MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SEC=300
MINERU_POLL_INTERVAL_SEC=3
MINERU_REQUEST_TIMEOUT_SEC=30

LEGACY_REFERENCE_DIR=reference/legacy-coze-review
PROMPTS_DIR=prompts
VENUES_DIR=venues
